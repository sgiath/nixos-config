    {
      "type": "timeseries",
      "title": "Requests per week by model",
      "description": "The ten models with the most requests in the range; the rest are summed as other.",
      "interval": "7d",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "agent-archive"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "agent-archive"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "WITH top AS\n(\n    SELECT model FROM agents.requests\n    WHERE $__timeFilter(ts) AND host IN (${host:singlequote}) AND tool IN (${tool:singlequote}) AND model != ''\n    GROUP BY model ORDER BY count() DESC LIMIT 10\n)\nSELECT toDateTime(toStartOfWeek(ts, 1)) AS time, if(model IN (SELECT model FROM top), model, 'other') AS model_name, count() AS requests\nFROM agents.requests\nWHERE $__timeFilter(ts) AND host IN (${host:singlequote}) AND tool IN (${tool:singlequote})\nGROUP BY time, model_name\nORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 85,
            "lineWidth": 1,
            "pointSize": 4,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisSoftMin": 0,
            "axisLabel": ""
          },
          "unit": "short",
          "color": {
