    {
      "type": "table",
      "title": "Projects",
      "description": "Repository from the working directory; branch worktrees fold into their repository. Cursor and Grok record no working directory.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "agent-archive"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "agent-archive"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT\n    multiIf(\n        cwd LIKE '/home/sgiath/nixos%', 'sgiath/nixos',\n        match(cwd, '^/home/sgiath/\\\\.t3/worktrees/[^/]+'), concat('worktree/', extract(cwd, '^/home/sgiath/\\\\.t3/worktrees/([^/]+)')),\n        match(cwd, '^/home/sgiath/develop/[^/]+/[^/]+'), concat(extract(cwd, '^/home/sgiath/develop/([^/]+)/'), '/', extract(cwd, '^/home/sgiath/develop/[^/]+/([^/.]+)')),\n        cwd LIKE '/home/sgiath/.pi/%', 'pi agent home',\n        cwd LIKE '/nas%', 'nas',\n        cwd LIKE '/tmp%' OR cwd LIKE '/home/sgiath/.t3/scratch%', 'scratch',\n        cwd = '', '(no working directory)',\n        'other') AS \"Project\",\n    count() AS \"Requests\",\n    uniq(tool, session_id) AS \"Sessions\",\n    topK(1)(tool)[1] AS \"Main harness\",\n    sum(output_tokens) AS \"Output tokens\"\nFROM agents.requests\nWHERE $__timeFilter(ts) AND host IN (${host:singlequote}) AND tool IN (${tool:singlequote})\nGROUP BY \"Project\"\nORDER BY count() DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
