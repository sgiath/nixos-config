    {
      "type": "table",
      "title": "Activity by weekday and hour (Europe/Prague)",
      "description": "Requests per local weekday and hour.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "agent-archive"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "agent-archive"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT\n    arrayElement(['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'], toDayOfWeek(t)) AS \"Day\",\n    countIf(toHour(t) = 0) AS \"00\", countIf(toHour(t) = 1) AS \"01\", countIf(toHour(t) = 2) AS \"02\", countIf(toHour(t) = 3) AS \"03\", countIf(toHour(t) = 4) AS \"04\", countIf(toHour(t) = 5) AS \"05\", countIf(toHour(t) = 6) AS \"06\", countIf(toHour(t) = 7) AS \"07\", countIf(toHour(t) = 8) AS \"08\", countIf(toHour(t) = 9) AS \"09\", countIf(toHour(t) = 10) AS \"10\", countIf(toHour(t) = 11) AS \"11\", countIf(toHour(t) = 12) AS \"12\", countIf(toHour(t) = 13) AS \"13\", countIf(toHour(t) = 14) AS \"14\", countIf(toHour(t) = 15) AS \"15\", countIf(toHour(t) = 16) AS \"16\", countIf(toHour(t) = 17) AS \"17\", countIf(toHour(t) = 18) AS \"18\", countIf(toHour(t) = 19) AS \"19\", countIf(toHour(t) = 20) AS \"20\", countIf(toHour(t) = 21) AS \"21\", countIf(toHour(t) = 22) AS \"22\", countIf(toHour(t) = 23) AS \"23\"\nFROM (SELECT toTimeZone(ts, 'Europe/Prague') AS t FROM agents.requests WHERE $__timeFilter(ts) AND host IN (${host:singlequote}) AND tool IN (${tool:singlequote}))\nGROUP BY toDayOfWeek(t)\nORDER BY toDayOfWeek(t)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "color-background",
              "mode": "basic"
            },
            "filterable": false,
            "width": 56
          },
          "color": {
            "mode": "continuous-BlPu"
          }
        },
        "overrides": [
