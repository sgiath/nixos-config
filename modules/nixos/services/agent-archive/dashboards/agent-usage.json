          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT\n    tool AS \"Harness\",\n    count() AS \"Sessions\",\n    countIf(is_subagent) AS \"Subagent sessions\",\n    quantile(0.5)(requests) AS \"Median requests\",\n    quantile(0.9)(requests) AS \"p90 requests\",\n    quantile(0.5)(dateDiff('second', started, last_request)) AS \"Median length\",\n    quantile(0.9)(dateDiff('second', started, last_request)) AS \"p90 length\"\nFROM agents.sessions\nWHERE $__timeFilter(started) AND host IN (${host:singlequote}) AND tool IN (${tool:singlequote})\nGROUP BY tool\nORDER BY count() DESC"
        }
