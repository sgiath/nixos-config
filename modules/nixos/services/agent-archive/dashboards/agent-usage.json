  "panels": [
    {
      "type": "stat",
      "title": "Requests",
      "description": "Prompt tokens include cache reads and writes. Cache reads and subagent requests are shares of the totals.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "agent-archive"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "agent-archive"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT\n    count() AS \"Requests\",\n    uniq(tool, session_id) AS \"Sessions\",\n    uniq(toDate(ts, 'Europe/Prague')) AS \"Active days\",\n    sum(input_tokens + cache_read_tokens + cache_write_tokens) AS \"Prompt tokens\",\n    sum(cache_read_tokens) / sum(input_tokens + cache_read_tokens + cache_write_tokens) AS \"Cache reads\",\n    sum(output_tokens) AS \"Output tokens\",\n    countIf(is_subagent) / count() AS \"Subagent requests\"\nFROM agents.requests\nWHERE $__timeFilter(ts) AND host IN (${host:singlequote}) AND tool IN (${tool:singlequote})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Active days"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Cache reads"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Subagent requests"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value_and_name",
        "orientation": "vertical",
        "wideLayout": true
      },
      "id": 1,
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "Tool calls",
      "description": "Tool calls include the OpenCode sessions recovered from the plugin hook copy (Feb-Jun 2026), which have no requests. Hours leave out their lsp_diagnostics results, which were stamped long after the call.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "agent-archive"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "agent-archive"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT\n    (SELECT count() FROM agents.tool_calls WHERE $__timeFilter(ts) AND host IN (${host:singlequote}) AND tool IN (${tool:singlequote})) AS \"Tool calls\",\n    (SELECT count() FROM agents.commands WHERE $__timeFilter(ts) AND host IN (${host:singlequote}) AND tool IN (${tool:singlequote})) AS \"Shell commands\",\n    (SELECT sum(duration_ms) / 3600000 FROM agents.tool_calls WHERE $__timeFilter(ts) AND host IN (${host:singlequote}) AND tool IN (${tool:singlequote}) AND NOT (tool = 'opencode' AND request_id = '' AND name = 'lsp_diagnostics')) AS \"Hours in tool calls\",\n    (SELECT countIf(is_error = 1) / countIf(is_error IS NOT NULL) FROM agents.tool_calls WHERE $__timeFilter(ts) AND host IN (${host:singlequote}) AND tool IN (${tool:singlequote})) AS \"Calls with an error\",\n    (SELECT count() FROM agents.opencode_recovered_sessions\n        WHERE $__timeFilter(started) AND host IN (${host:singlequote}) AND has([${tool:singlequote}], 'opencode')) AS \"Recovered OpenCode sessions\""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Hours in tool calls"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Calls with an error"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Recovered OpenCode sessions"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value_and_name",
        "orientation": "vertical",
        "wideLayout": true
      },
      "id": 2,
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 4
      }
