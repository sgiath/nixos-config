            "uid": "agent-archive"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT\n    tool,\n    sum(input_tokens) AS \"Uncached input\",\n    sum(cache_read_tokens) AS \"Cache reads\",\n    sum(cache_write_tokens) AS \"Cache writes\",\n    sum(output_tokens) AS \"Output\"\nFROM agents.requests\nWHERE $__timeFilter(ts) AND host IN (${host:singlequote}) AND tool IN (${tool:singlequote})\nGROUP BY tool\nORDER BY count() DESC"
