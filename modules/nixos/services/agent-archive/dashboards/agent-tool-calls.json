    {
      "type": "table",
      "title": "Permission waits",
      "description": "From OpenTelemetry (Claude Code and Codex since 2026-10-14): time spent executing versus blocked on a permission decision.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "agent-archive"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "agent-archive"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT\n    c.tool AS \"Harness\",\n    t.name AS \"Tool\",\n    count() AS \"Calls\",\n    countIf(t.blocked_ms > 1000) AS \"Blocked over 1 s\",\n    sum(t.execution_ms) / 1000 AS \"Executing\",\n    sum(t.blocked_ms) / 1000 AS \"Waiting for permission\",\n    any(t.decision_source) AS \"Decision source\"\nFROM agents.tool_timing AS t\nINNER JOIN agents.tool_calls AS c ON c.tool = t.tool AND c.call_id = t.call_id\nWHERE $__timeFilter(c.ts) AND c.host IN (${host:singlequote}) AND c.tool IN (${tool:singlequote})\nGROUP BY c.tool, t.name\nORDER BY sum(t.blocked_ms) DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Executing"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Waiting for permission"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": []
      },
      "id": 8,
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 36
      }
    },
