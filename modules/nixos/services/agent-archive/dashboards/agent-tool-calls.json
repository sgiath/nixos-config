    {
      "type": "table",
      "title": "Programs",
      "description": "First program of each command after a leading cd and variable assignments.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "agent-archive"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "agent-archive"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT\n    replaceRegexpOne(extract(replaceRegexpOne(command, '^\\\\s*(cd\\\\s+\\\\S+\\\\s*&&\\\\s*)?([A-Za-z_][A-Za-z0-9_]*=\\\\S*\\\\s+)*', ''), '^(\\\\S+)'), '^.*/', '') AS \"Program\",\n    count() AS \"Commands\",\n    count() / (SELECT count() FROM agents.commands WHERE $__timeFilter(ts) AND host IN (${host:singlequote}) AND tool IN (${tool:singlequote})) AS \"Share\",\n    topK(1)(tool)[1] AS \"Main harness\"\nFROM agents.commands\nWHERE $__timeFilter(ts) AND host IN (${host:singlequote}) AND tool IN (${tool:singlequote})\nGROUP BY \"Program\"\nORDER BY count() DESC\nLIMIT 100"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          }
        },
