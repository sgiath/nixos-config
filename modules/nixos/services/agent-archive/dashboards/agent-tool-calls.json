    {
      "type": "timeseries",
      "title": "grep share of grep and rg",
      "description": "Per week, among commands that run grep or rg; weeks with fewer than ten such commands are left out.",
      "interval": "7d",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "agent-archive"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "agent-archive"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT toDateTime(toStartOfWeek(ts, 1)) AS time, tool,\n    countIf(match(command, '(^|[|;&(]\\\\s*|\\\\s(xargs|sudo|env|time)\\\\s+)grep\\\\b')) / nullIf(countIf(match(command, '(^|[|;&(]\\\\s*|\\\\s(xargs|sudo|env|time)\\\\s+)(grep|rg)\\\\b')), 0) AS grep_share\nFROM agents.commands\nWHERE $__timeFilter(ts) AND host IN (${host:singlequote}) AND tool IN (${tool:singlequote})\nGROUP BY time, tool\nHAVING countIf(match(command, '(^|[|;&(]\\\\s*|\\\\s(xargs|sudo|env|time)\\\\s+)(grep|rg)\\\\b')) >= 10\nORDER BY time"
