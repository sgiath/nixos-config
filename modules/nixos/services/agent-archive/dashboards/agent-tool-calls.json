          {
            "matcher": {
              "id": "byName",
              "options": "Share"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Commands",
            "desc": true
          }
        ]
