          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT\n    tool AS \"Harness\",\n    name AS \"Tool\",\n    multiIf(\n    name IN ('Bash', 'bash', 'exec_command', 'exec', 'shell_command', 'write_stdin', 'interactive_bash', 'shell', 'Shell', 'run_terminal_cmd', 'run_terminal_command_v2', 'run_terminal_command'), 'shell',\n    name IN ('eval', 'execute', 'mcpScript', 'mcp_script', 'ipython'), 'code mode',\n    name IN ('Read', 'read', 'Grep', 'grep', 'Glob', 'glob', 'find', 'ls', 'list', 'ToolSearch', 'tool_search', 'session_search', 'look_at', 'LS', 'read_file', 'read_file_v2', 'list_dir', 'codebase_search', 'glob_file_search', 'ripgrep_raw_search', 'file_search', 'read_lints', 'rg', 'search', 'search_tool', 'search_conversations'), 'read & search',\n    name IN ('Edit', 'edit', 'Write', 'write', 'apply_patch', 'MultiEdit', 'NotebookEdit', 'search_replace', 'write_file', 'edit_file', 'edit_file_v2', 'delete_file', 'edit_notebook'), 'edit & write',\n    name IN ('task', 'Task', 'Agent', 'call_omo_agent', 'subagent', 'subagent_wait', 'wait', 'wait_agent', 'sleep', 'background_output', 'yield', 'hub', 'vibe_wait', 'delegate_task', 'task_status', 'run_experiment', 'spawn_agent', 'send_message', 'advise', 'mcp__t3-code__t3_thread_wait', 'mcp__t3-code__delegate_task', 'mcp__t3-code__watch_pull_request', 'mcp__t3-code__task_status'), 'delegation & waiting',\n    name IN ('question', 'ask', 'AskUserQuestion', 'ask_user_question', 'request_user_input', 'interview', 'plan_exit', 'submit_plan', 'contact_supervisor', 'ExitPlanMode', 'fn_review_step', 'ask_question', 'submit_reminder_decision'), 'user interaction',\n    name IN ('webfetch', 'websearch', 'web_search', 'WebFetch', 'WebSearch', 'web_fetch'), 'web',\n    name IN ('todo', 'todowrite', 'TodoWrite', 'update_plan', 'task_update', 'task_create', 'task_edit', 'memory', 'log_experiment', 'skill', 'Skill', 'skill_mcp', 'todo_write', 'create_plan', 'read_skill'), 'planning & notes',\n    startsWith(name, 'lsp') OR position(name, 'codegraph') > 0, 'read & search',\n    'MCP & other') AS \"Category\",\n    count() AS \"Calls\",\n    countIf(duration_ms IS NOT NULL) AS \"Timed calls\",\n    sumIf(duration_ms, NOT (tool = 'opencode' AND request_id = '' AND name = 'lsp_diagnostics')) / 3600000 AS \"Hours\",\n    quantileIf(0.5)(duration_ms, duration_ms IS NOT NULL) / 1000 AS \"Median\",\n    quantileIf(0.9)(duration_ms, duration_ms IS NOT NULL) / 1000 AS \"p90\",\n    countIf(is_error = 1) / nullIf(countIf(is_error IS NOT NULL), 0) AS \"Error share\",\n    avg(output_bytes) AS \"Mean output\"\nFROM agents.tool_calls\nWHERE $__timeFilter(ts) AND host IN (${host:singlequote}) AND tool IN (${tool:singlequote})\nGROUP BY tool, name\nORDER BY count() DESC\nLIMIT 300"
        }
      ],
