#!/usr/bin/env python3
"""plan-status: derive the state of every slice in a drive plan.

Usage: plan-status <plan-dir> [--no-deploy-check] [--full | --record]

Reads <plan-dir>/plan.md and <plan-dir>/NN-*.md, looks up the slice branches
on GitHub with `gh` or GitLab with `glab`, finds each slice's worker threads with
`t3 thread list`, and prints one JSON document on stdout. `--full` prints the whole
status and writes nothing except what `deploy_check` itself does.
See ../references/plan-format.md.

Ticks: by default it compares slice states, PRs, worker threads, plan and slice files,
state-directory files and the launch/ask lists with the snapshot recorded by the
last `--record`. When nothing changed it prints only `{"changed": false, ...}` and the
step that ends the tick; otherwise the full status plus `changes`, and it stages the
new snapshot. `--record` (run once the tick has acted) makes the staged snapshot the
baseline, so a tick that stops early reports the same changes again. A worker's item
count is reported but not compared: tool traffic alone is not a change. Its pending
requests are compared, since a question changes nothing else a running worker reports.

Questions: `asked/NN.md` in the state directory records questions sent to the user;
`answers/NN.md` records the answers. Asked-but-unanswered slices are listed in
`awaiting_answers` and never offered again in `ask_next`/`ask_ready`.

Slice states:
  blocked      a blocker is not done yet
  ready        blockers done, no branch or PR yet
  in_progress  a local branch exists in the plan repository, no PR yet, or a slice
               repository still lacks a merged PR (`missing_repos`)
  in_review    at least one open PR for the slice branch
  closed       at least one required PR closed without merging, none open
  merged       all PRs merged, waiting for deploy (deploy_gate: true)
  done         merged and deployed, or merged with deploy_gate: false
"""

import hashlib
import json
import os
import re
import subprocess
import sys
from pathlib import Path
from urllib.parse import quote, urlencode

SLICE_FILE = re.compile(r"^(\d{2,3})-([a-z0-9-]+)\.md$")


def fail(message):
    print(f"plan-status: {message}", file=sys.stderr)
    sys.exit(2)


def run(args, cwd=None, check=True):
    result = subprocess.run(args, cwd=cwd, capture_output=True, text=True)
    if check and result.returncode != 0:
        fail(f"{' '.join(args)} failed: {result.stderr.strip()}")
    return result


def parse_value(raw):
    raw = raw.strip()
    if raw.startswith("[") and raw.endswith("]"):
        return [item.strip().strip("\"'") for item in raw[1:-1].split(",") if item.strip()]
    if raw in ("true", "false"):
        return raw == "true"
    if re.fullmatch(r"\d+", raw) and not raw.startswith("0"):
        return int(raw)
    return raw.strip("\"'")


def frontmatter(path):
    """Flat `key: value` frontmatter; lists as `[a, b]`. Nothing nested."""
    lines = path.read_text().splitlines()
    if not lines or lines[0].strip() != "---":
        fail(f"{path} has no frontmatter")
    meta = {}
    for line in lines[1:]:
        if line.strip() == "---":
            return meta
        if not line.strip() or line.lstrip().startswith("#"):
            continue
        key, sep, value = line.partition(":")
        if not sep:
            fail(f"{path}: cannot parse frontmatter line {line!r}")
        meta[key.strip()] = parse_value(value)
    fail(f"{path}: frontmatter is not closed")


def repo_slug(root):
    url = run(["git", "remote", "get-url", "origin"], cwd=root).stdout.strip()
    match = re.search(r"(github\.com|gitlab\.com)[:/]([^/]+/.+?)(?:\.git)?$", url)
    if not match:
        fail(f"origin {url!r} is not a supported GitHub or GitLab remote")
    return match.groups()


def pull_requests(repo, branches, host):
    prs = []
    for branch in sorted(branches):
        if host == "gitlab.com":
            query = urlencode({"scope": "all", "state": "all", "source_branch": branch, "per_page": 100})
            result = run([
                "glab", "api", f"projects/{quote(repo, safe='')}/merge_requests?{query}",
                "--paginate", "--hostname", host,
            ])
            remaining = result.stdout.strip()
            while remaining:
                page, offset = json.JSONDecoder().raw_decode(remaining)
                for pr in page:
                    if pr["source_branch"] == branch:
                        prs.append({
                            "repo": repo,
                            "number": pr["iid"],
                            "url": pr["web_url"],
                            "branch": branch,
                            "state": "open" if pr["state"] in ("opened", "locked") else pr["state"],
                            "draft": pr.get("draft", pr.get("work_in_progress", False)),
                            "merged_at": pr.get("merged_at"),
                            "merge_commit": pr.get("merge_commit_sha") or pr.get("squash_commit_sha"),
                            "head": pr.get("sha"),
                            "updated_at": pr.get("updated_at"),
                        })
                remaining = remaining[offset:].strip()
        else:
            result = run([
                "gh", "pr", "list", "--repo", repo, "--state", "all", "--limit", "200", "--head", branch,
                "--json", "number,url,state,headRefName,headRefOid,updatedAt,mergedAt,mergeCommit,isDraft",
            ])
            for pr in json.loads(result.stdout):
                if pr["headRefName"] == branch:
                    prs.append({
                        "repo": repo,
                        "number": pr["number"],
                        "url": pr["url"],
                        "branch": branch,
                        "state": pr["state"].lower(),
                        "draft": pr["isDraft"],
                        "merged_at": pr["mergedAt"],
                        "merge_commit": (pr.get("mergeCommit") or {}).get("oid"),
                        "head": pr["headRefOid"],
                        "updated_at": pr["updatedAt"],
                    })
    return prs


def pending_requests(thread_id):
    """Open questions and approvals on a thread; `t3 thread list` omits them. None when unavailable."""
    try:
        result = subprocess.run(
            ["t3", "thread", "show", thread_id, "--json"],
            capture_output=True, text=True, timeout=30,
        )
        return json.loads(result.stdout)["thread"]["pendingRequestCount"] if result.returncode == 0 else None
    except (OSError, subprocess.TimeoutExpired, json.JSONDecodeError, KeyError):
        return None


def worker_threads(root, topic):
    """Worker threads per slice id, from the T3 server's own CLI; None when unavailable."""
    try:
        result = subprocess.run(
            ["t3", "thread", "list", "--json", "--project", str(root)],
            capture_output=True, text=True, timeout=60,
        )
        threads = json.loads(result.stdout) if result.returncode == 0 else None
    except (OSError, subprocess.TimeoutExpired, json.JSONDecodeError):
        threads = None
    if not isinstance(threads, list):
        return None
    title = re.compile(rf"^{re.escape(topic)} (\d{{2,3}})\b")
    workers = {}
    for thread in threads:
        match = title.match(thread.get("title") or "")
        if match and not thread.get("parentThreadId"):
            workers.setdefault(match.group(1), []).append({
                **{key: thread.get(key) for key in ("threadId", "title", "status", "latestRunId", "itemCount", "settled")},
                "pendingRequests": 0 if thread.get("settled") else pending_requests(thread["threadId"]),
            })
    return workers


SNAPSHOT_FILES = ("asked", "answers", "deployed", "gates", "final-gate.md", "traps.md")


def snapshot(status, state_dir, plan_dir):
    files = {}
    for item in sorted(plan_dir.glob("*.md")):
        files[f"plan/{item.name}"] = hashlib.sha256(item.read_bytes()).hexdigest()
    for name in SNAPSHOT_FILES:
        path = state_dir / name
        for item in sorted(path.rglob("*")) if path.is_dir() else [path]:
            if item.is_file():
                files[str(item.relative_to(state_dir))] = hashlib.sha256(item.read_bytes()).hexdigest()
    return {
        "slices": {
            item["id"]: {
                "state": item["state"],
                "prs": {pr["url"]: [pr["state"], pr["draft"], pr["head"], pr["updated_at"]] for pr in item["prs"]},
                "workers": None if item["workers"] is None else {
                    w["threadId"]: [w["status"], w["latestRunId"], w["pendingRequests"], w["settled"]]
                    for w in item["workers"]
                },
            }
            for item in status["slices"]
        },
        "files": files,
        "launch": {key: status[key] for key in ("next", "ask_next", "ask_ready", "awaiting_answers", "complete")},
    }


def describe_changes(old, new):
    if old is None:
        return ["no recorded snapshot"]
    changes = []
    for slice_id, item in new["slices"].items():
        before = old["slices"].get(slice_id)
        if before is None:
            changes.append(f"slice {slice_id}: new")
            continue
        if before["state"] != item["state"]:
            changes.append(f"slice {slice_id}: {before['state']} -> {item['state']}")
        for url in sorted(set(before["prs"]) | set(item["prs"])):
            if before["prs"].get(url) != item["prs"].get(url):
                changes.append(f"slice {slice_id}: PR {url} changed")
        if item["workers"] is None:
            changes.append(f"slice {slice_id}: worker threads unavailable")
            continue
        for thread_id in sorted(set(before["workers"] or {}) | set(item["workers"])):
            if (before["workers"] or {}).get(thread_id) != item["workers"].get(thread_id):
                changes.append(f"slice {slice_id}: worker {thread_id} changed")
    changes += [f"slice {s}: removed" for s in old["slices"] if s not in new["slices"]]
    for key, value in new["launch"].items():
        if old.get("launch", {}).get(key) != value:
            changes.append(f"{key}: {old.get('launch', {}).get(key)} -> {value}")
    for name in sorted(set(old["files"]) | set(new["files"])):
        if old["files"].get(name) != new["files"].get(name):
            changes.append(f"{'plan' if name.startswith('plan/') else 'state'} file {name.removeprefix('plan/')} changed")
    return changes


def main():
    args = sys.argv[1:]
    flags = {arg for arg in args if arg.startswith("--")}
    args = [arg for arg in args if not arg.startswith("--")]
    if len(args) != 1 or flags - {"--no-deploy-check", "--full", "--record"} or {"--full", "--record"} <= flags:
        fail("usage: plan-status <plan-dir> [--no-deploy-check] [--full | --record]")
    skip_deploy_check = "--no-deploy-check" in flags

    plan_dir = Path(args[0]).resolve()
    plan_file = plan_dir / "plan.md"
    if not plan_file.is_file():
        fail(f"{plan_file} does not exist")
    plan = frontmatter(plan_file)

    root = Path(run(["git", "rev-parse", "--show-toplevel"], cwd=plan_dir).stdout.strip())
    host, main_repo = repo_slug(root)
    topic = plan.get("topic") or fail("plan.md needs `topic`")
    prefix = plan.get("branch_prefix", f"{topic}/")
    repos = plan.get("repos") or [main_repo]
    if main_repo not in repos:
        repos = [main_repo, *repos]
    parallel = int(plan.get("parallel", 5))
    deploy_check = plan.get("deploy_check")

    state_root = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state"))
    state_dir = state_root / "drive" / main_repo.rsplit("/", 1)[-1] / plan_dir.name
    if "--record" in flags:
        staged = state_dir / "tick-snapshot.staged.json"
        if not staged.is_file():
            fail(f"{staged} does not exist; run plan-status without --record first")
        staged.replace(state_dir / "tick-snapshot.json")
        return

    slices = {}
    for path in sorted(plan_dir.iterdir()):
        match = SLICE_FILE.match(path.name)
        if not match:
            continue
        meta = frontmatter(path)
        slice_id = match.group(1)
        slice_repos = meta.get("repos") or [main_repo]
        slice_repos = [slice_repos] if isinstance(slice_repos, str) else slice_repos
        if set(slice_repos) - set(repos):
            fail(f"slice {slice_id} names repos missing from plan.md repos: {sorted(set(slice_repos) - set(repos))}")
        slices[slice_id] = {
            "id": slice_id,
            "file": str(path),
            "title": meta.get("title", match.group(2)),
            "blocked_by": [str(b).zfill(len(slice_id)) for b in meta.get("blocked_by", [])],
            "deploy_gate": bool(meta.get("deploy_gate", True)),
            "migration": bool(meta.get("migration", False)),
            "branch": meta.get("branch", f"{prefix}{slice_id}-{match.group(2)}"),
            "linear_issue": meta.get("linear_issue"),
            "repos": slice_repos,
            "missing_repos": [],
            "prs": [],
            "answered": (state_dir / "answers" / f"{slice_id}.md").is_file(),
            "asked": (state_dir / "asked" / f"{slice_id}.md").is_file(),
        }

    order = [str(item) for item in plan.get("order", [])] or sorted(slices)
    unknown = [item for item in order if item not in slices]
    if unknown:
        fail(f"plan.md order names missing slices: {unknown}")
    order += [item for item in sorted(slices) if item not in order]

    branches = {item["branch"] for item in slices.values() if item["branch"]}
    if len(branches) != sum(bool(item["branch"]) for item in slices.values()):
        fail("slice branches must be distinct")
    for repo in repos:
        for pr in pull_requests(repo, branches, host):
            for item in slices.values():
                if pr["branch"] == item["branch"]:
                    item["prs"].append(pr)

    local_branches = set(
        run(
            ["git", "for-each-ref", "--format=%(refname:short)", "refs/heads/"],
            cwd=root,
        ).stdout.split()
    )

    def deployed(item):
        if (state_dir / "deployed" / item["id"]).is_file():
            return True
        if not deploy_check or skip_deploy_check:
            return False
        main_prs = [pr for pr in item["prs"] if pr["repo"] == main_repo and pr["merge_commit"]]
        if not main_prs:
            return False
        for pr in main_prs:
            command = deploy_check.replace("{sha}", pr["merge_commit"])
            if subprocess.run(command, shell=True, cwd=root, capture_output=True).returncode != 0:
                return False
        return True

    workers = worker_threads(root, topic)
    for item in slices.values():
        item["workers"] = None if workers is None else workers.get(item["id"], [])

    for item in slices.values():
        states = {pr["state"] for pr in item["prs"]}
        if "open" in states:
            item["state"] = "in_review"
        elif "closed" in states:
            item["state"] = "closed"
        elif states == {"merged"}:
            item["missing_repos"] = [
                repo for repo in item["repos"] if not any(pr["repo"] == repo for pr in item["prs"])
            ]
            if item["missing_repos"]:
                item["state"] = "in_progress"
            elif not item["deploy_gate"] or deployed(item):
                item["state"] = "done"
            else:
                item["state"] = "merged"
        elif item["branch"] in local_branches:
            item["state"] = "in_progress"
        else:
            item["state"] = None

    for item in slices.values():
        if item["state"] is None:
            missing = [b for b in item["blocked_by"] if b not in slices]
            if missing:
                fail(f"slice {item['id']} is blocked by missing slices {missing}")
            done = all(slices[b]["state"] == "done" for b in item["blocked_by"])
            item["state"] = "ready" if done else "blocked"

    # The slice whose gate questions to ask ahead: the first unstarted slice in plan
    # order that is neither answered nor already asked, whose blockers have all at
    # least started.
    ask_next = None
    for slice_id in order:
        item = slices[slice_id]
        if item["state"] not in ("ready", "blocked") or item["answered"] or item["asked"]:
            continue
        if all(slices[b]["state"] not in ("ready", "blocked") for b in item["blocked_by"]):
            ask_next = slice_id
        break

    active = [s for s in slices.values() if s["state"] in ("in_progress", "in_review")]
    capacity = max(parallel - len(active), 0)
    ask_ready = [
        i
        for i in order
        if slices[i]["state"] == "ready" and not slices[i]["answered"] and not slices[i]["asked"]
    ]
    awaiting_answers = [i for i in order if slices[i]["asked"] and not slices[i]["answered"]]
    ready = [slices[i] for i in order if slices[i]["state"] == "ready" and slices[i]["branch"]]
    if any(s["migration"] for s in active):
        ready = []
    elif active:
        ready = [s for s in ready if not s["migration"]]
    elif ready and ready[0]["migration"]:
        ready = ready[:1]
    else:
        ready = [s for s in ready if not s["migration"]]

    status = {
        "plan": str(plan_dir),
        "topic": topic,
        "repository": main_repo,
        "host": host,
        "repos": repos,
        "branch_prefix": prefix,
        "parallel": parallel,
        "deploy_check": deploy_check,
        "state_dir": str(state_dir),
        "order": order,
        "next": [s["id"] for s in ready[:capacity]],
        "ask_next": ask_next,
        "ask_ready": ask_ready,
        "awaiting_answers": awaiting_answers,
        "complete": all(s["state"] == "done" for s in slices.values()),
        "slices": [slices[i] for i in order],
    }
    if "--full" not in flags:
        current = snapshot(status, state_dir, plan_dir)
        recorded = state_dir / "tick-snapshot.json"
        changes = describe_changes(json.loads(recorded.read_text()) if recorded.is_file() else None, current)
        if not changes:
            print(json.dumps({
                "changed": False,
                "state_dir": str(state_dir),
                "next_step": "Nothing changed: end the turn now with no message and no further tool calls.",
            }))
            return
        state_dir.mkdir(parents=True, exist_ok=True)
        (state_dir / "tick-snapshot.staged.json").write_text(json.dumps(current))
        status = {"changed": True, "changes": changes, **status}
    print(json.dumps(status, indent=2))


if __name__ == "__main__":
    main()
